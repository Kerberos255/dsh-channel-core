        },
        "advanced": false,
        "fold": "更多会话设置"
      },
      {
        "key": "workspacePath",
        "group": "会话与输入",
        "label": "工作区路径",
        "type": "text",
        "help": "未选择角色时生效。留空使用官方默认工作区；填写后按工作区隔离会话。",
        "when": {
          "rolePreset": ""
        },
        "advanced": false,
        "fold": "更多会话设置"
      },
      {
        "key": "resolvedWorkspace",
        "label": "实际工作区",
        "type": "readonly",
        "detail": "workspacePath",
        "placeholder": "渠道连接后显示",
        "help": "显示渠道新会话实际使用的目录。",
        "group": "会话与输入",
        "advanced": false,
        "fold": "更多会话设置"
      },
      {
        "key": "streaming.mode",
        "group": "回复与显示",
        "label": "回复显示方式",
        "type": "select",
        "options": [
          [
            "progress",
            "执行进度（progress）"
          ],
          [
            "partial",
            "实时正文（partial）"
          ],
          [
            "off",
