{
  "dsh-channel-discord": {
    "rowId": "channel-discord",
    "endpoint": "discordChannelSettings",
    "title": "Discord 渠道",
    "description": "将 Discord 消息接入 DSH 原生会话，支持线程、交互和渠道设置。",
    "standalone": true,
    "actionLabel": "重新连接",
    "credentialFields": {
      "tokenRef": "Discord Bot Token"
    },
    "fields": [
      {
        "key": "enabled",
        "label": "连接渠道",
        "type": "boolean",
        "help": "保存后自动连接；有效凭证用于登录，消息接收范围单独配置。",
        "group": "账号与连接",
        "advanced": false
      },
      {
        "key": "applicationId",
        "type": "readonly",
        "label": "应用 ID",
        "detail": "applicationId",
        "placeholder": "连接后自动识别",
        "help": "登录成功后自动读取 Discord 的应用 ID。",
        "group": "账号与连接",
        "advanced": false
      },
      {
        "key": "credentialSecret",
        "label": "Discord Bot Token",
        "type": "credential",
        "group": "账号与连接",
        "advanced": false
      },
      {
        "key": "accountId",
        "label": "账号标识",
        "type": "text",
        "help": "本地用于区分机器人账号，配置后保持稳定。",
        "group": "账号与连接",
        "advanced": false,
        "fold": "更多连接设置"
      },
      {
        "key": "tokenRef",
        "label": "凭证名称",
        "type": "text",
        "help": "Bot Token 在上方机器人凭证区保存。",
        "group": "账号与连接",
        "advanced": false,
        "fold": "更多连接设置"
      },
      {
        "key": "dmPolicy",
        "group": "接收与权限",
        "label": "私聊接收范围",
        "type": "select",
        "options": [
          [
            "disabled",
            "关闭私聊"
          ],
          [
            "allowlist",
            "仅指定用户"
          ],
          [
            "all",
            "所有私聊用户"
          ]
        ],
        "help": "与服务器范围分别设置；选择所有私聊用户后无需填写用户 ID，各用户的私聊会话独立。",
        "advanced": false
      },
      {
        "key": "allowedUsers",
        "group": "接收与权限",
        "label": "允许使用的用户 ID",
        "type": "list",
        "help": "私聊选择指定用户、服务器选择指定范围时使用，每行一个；选择全部范围时无需填写。",
        "when": [
          {
            "dmPolicy": "allowlist"
          },
          {
            "allowGroups": true,
            "groupPolicy": "allowlist"
          }
        ],
        "emptyHelp": "指定用户模式需要填写用户 ID，空列表暂不接收消息。",
        "advanced": false
      },
      {
        "key": "allowGroups",
        "group": "接收与权限",
        "label": "接收服务器消息",
        "type": "boolean",
        "advanced": false
      },
      {
        "key": "groupPolicy",
        "group": "接收与权限",
        "label": "服务器接收范围",
        "type": "select",
        "options": [
          [
            "allowlist",
            "指定允许的用户和频道"
          ],
          [
            "all",
            "服务器内所有用户、所有频道"
          ]
        ],
        "help": "只应用于服务器消息；私聊由私聊接收范围单独设置。",
        "when": {
          "allowGroups": true
        },
        "advanced": false
      },
      {
        "key": "allowedGroups",
        "group": "接收与权限",
        "label": "允许的频道 ID",
        "type": "list",
        "help": "指定范围时使用，每行一个频道 ID；选择全部范围时无需填写。",
        "when": {
          "allowGroups": true,
          "groupPolicy": "allowlist"
        },
        "emptyHelp": "指定频道模式需要填写频道 ID，空列表暂不接收服务器消息。",
        "advanced": false
      },
      {
        "key": "requireMention",
        "group": "接收与权限",
        "label": "服务器消息需要 @ 机器人",
        "type": "boolean",
        "when": {
          "allowGroups": true
        },
        "advanced": false
      },
      {
        "key": "rolePreset",
        "group": "会话与输入",
        "label": "使用角色",
        "type": "role",
        "help": "从「指令文件与角色」选择角色，渠道新会话自动进入对应工作区。",
        "advanced": false
      },
      {
        "key": "inputMode",
        "group": "会话与输入",
        "label": "新消息输入方式",
        "type": "select",
        "options": [
          [
            "inherit",
            "跟随“渠道与会话”设置"
          ],
          [
            "steering",
            "Steering：加入当前任务"
          ],
          [
            "queue",
            "Queue：排入后续轮次"
          ],
          [
            "interrupt",
            "Interrupt：停止当前轮次并接收新输入"
          ]
        ],
        "advanced": false
      },
      {
        "key": "registerCommands",
        "label": "注册 /dsh 指令",
        "group": "会话与输入",
        "type": "boolean",
        "help": "连接后自动添加 /dsh；保留该机器人已有的其他指令。",
        "advanced": false,
        "fold": "更多会话设置"
      },
      {
        "key": "agentPreset",
        "group": "会话与输入",
        "label": "Agent 预设 ID",
        "type": "text",
        "advanced": false,
        "when": {
          "rolePreset": ""
        },
        "fold": "更多会话设置"
      },
      {
        "key": "workspacePath",
        "group": "会话与输入",
        "label": "工作区路径",
        "type": "text",
        "help": "未选择角色时生效。留空跟随客户端已登记的默认工作区；填写后使用指定目录。",
        "advanced": false,
        "when": {
          "rolePreset": ""
        },
        "fold": "更多会话设置"
      },
      {
        "key": "resolvedWorkspace",
        "label": "实际工作区",
        "type": "readonly",
        "detail": "workspacePath",
        "placeholder": "渠道连接后显示",
        "group": "会话与输入",
        "advanced": false,
        "help": "显示渠道新会话实际使用的目录。",
        "fold": "更多会话设置"
      },
      {
        "key": "streaming.mode",
        "group": "回复与显示",
        "label": "回复显示方式",
        "type": "select",
        "options": [
          [
            "progress",
            "执行进度（progress）"
          ],
          [
            "partial",
            "实时正文（partial）"
          ],
          [
            "off",
            "仅最终回复（off）"
          ]
        ],
        "help": "进度模式交替滚动显示草稿和工具；Discord 完成后仅保留正文，飞书完成后分别显示折叠草稿卡和独立正文卡。",
        "advanced": false
      },
      {
        "key": "displayIcon",
        "group": "回复与显示",
        "label": "Agent 图标",
        "type": "text",
        "placeholder": "🐋",
        "help": "Discord 进度及提问消息头的自定义图标，默认 🐋。推荐单个 Emoji 或组合 Emoji。",
        "advanced": false
      },
      {
        "key": "streaming.footer.status",
        "group": "回复与显示",
        "label": "显示状态",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "在底部显示任务完成、失败或停止状态。"
      },
      {
        "key": "streaming.footer.elapsed",
        "group": "回复与显示",
        "label": "显示任务耗时",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "从本次原生 Turn 开始计时，显示完成耗时。"
      },
      {
        "key": "streaming.footer.model",
        "group": "回复与显示",
        "label": "显示模型名称",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "默认开启；从当前 Session 的模型选择读取，读不到时隐藏。"
      },
      {
        "key": "streaming.footer.context",
        "group": "回复与显示",
        "label": "显示上下文用量",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "默认开启；从 DSH 原生 Token Meter 读取已占用 Token。没有可信值时不显示。"
      },
      {
        "key": "streaming.footer.tokens",
        "group": "回复与显示",
        "label": "显示输入／输出 Token",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "默认关闭；仅在原生运行指标可用时显示。"
      },
      {
        "key": "streaming.footer.cache",
        "group": "回复与显示",
        "label": "显示缓存用量",
        "type": "boolean",
        "advanced": false,
        "fold": "更多显示设置",
        "help": "默认关闭；仅在原生运行指标可用时显示。"
      },
      {
        "key": "streaming.progress.toolProgress",
        "label": "显示工具进度",
        "type": "boolean",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        }
      },
      {
        "key": "streaming.progress.commentary",
        "label": "显示简短执行说明",
        "type": "boolean",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "help": "显示模型已提交的阶段性公开文字（📝 草稿）与简短执行说明（💬）；不包含尚未提交的实时正文草稿。任务完成后不保留中间进度。"
      },
      {
        "key": "streaming.progress.toolDetail",
        "label": "显示命令与目标摘要",
        "type": "boolean",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "help": "在工具名后附上简短目标，例如“执行命令 · npm pack”；敏感内容自动打码。"
      },
      {
        "key": "streaming.progress.narration",
        "label": "显示思考",
        "type": "boolean",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "help": "仅在已认领主人的 Discord 私聊中，显示模型实际产生的思考，以及正在生成、尚未提交的正文草稿。已提交的阶段性公开文字由「显示简短执行说明」控制。群聊和其他私聊不会展示未提交内容；任务结束后清除临时进度。默认关闭。"
      },
      {
        "key": "throttleMs",
        "group": "回复与显示",
        "label": "进度消息刷新间隔（毫秒）",
        "type": "number",
        "min": 400,
        "max": 5000,
        "when": [
          {
            "streaming.mode": "progress"
          },
          {
            "streaming.mode": "partial"
          }
        ],
        "advanced": false,
        "fold": "更多显示设置",
        "help": "Discord 默认 1100 毫秒。将这段时间内的思考、草稿和工具进度合并后更新同一条消息，适用于执行进度和实时正文模式；不改变模型生成速度或工具执行间隔。设置过短可能增加 Discord 编辑请求并触发限流。"
      },
      {
        "key": "streaming.progress.maxLines",
        "label": "最多显示进度条目",
        "type": "number",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "min": 1,
        "max": 12,
        "fold": "更多显示设置",
        "help": "默认显示最近 5 个逻辑进度条目：一段思考、一条草稿或一项工具各算一条，段落换行不额外计数。超过上限时，空间足够则优先保留最近的思考和草稿，剩余位置显示最近工具与简短说明。"
      },
      {
        "key": "streaming.progress.maxLineChars",
        "label": "工具与简短说明字数上限",
        "type": "number",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "min": 40,
        "max": 300,
        "fold": "更多显示设置",
        "help": "默认每条 120 字符，限制工具状态、目标摘要及简短执行说明的显示长度；不控制思考或正文草稿，它们使用下方的独立字数上限。"
      },
      {
        "key": "streaming.progress.draftMaxChars",
        "label": "思考与草稿单条字数上限",
        "type": "number",
        "group": "回复与显示",
        "advanced": false,
        "when": {
          "streaming.mode": "progress"
        },
        "min": 120,
        "max": 1000,
        "fold": "更多显示设置",
        "help": "默认每条 600 字符，限制每个思考或草稿进度条目的显示长度，保留原有段落并优先展示末尾。这不是模型输出上限；Discord 整条消息空间不足时仍会自动缩短。"
      },
      {
        "key": "ownerMode",
        "group": "主人与记忆",
        "label": "主人认领方式",
        "type": "select",
        "options": [
          [
            "first-dm",
            "首次私聊自动认领（默认）"
          ],
          [
            "manual",
            "手动指定主人"
          ]
        ],
        "help": "首次认领仅接受该机器人首位私聊用户；群聊不会认领。认领后永久保存，重启或新会话不会更换。",
        "advanced": false
      },
      {
        "key": "ownerUserId",
        "group": "主人与记忆",
        "label": "主人平台用户 ID",
        "type": "text",
        "when": {
          "ownerMode": "manual"
        },
        "help": "手动填写 Discord 用户 ID；保存后立即覆盖该渠道主人。",
        "advanced": false
      },
      {
        "key": "ownerStatus",
        "group": "主人与记忆",
        "label": "当前主人",
        "type": "readonly",
        "detail": "ownerStatus",
        "help": "当前主人已持久记录，不因重启或新建会话改变。",
        "advanced": false
      },
      {
        "key": "memoryNamespace",
        "group": "主人与记忆",
        "label": "记忆命名空间",
        "type": "text",
        "advanced": false,
        "fold": "更多身份与记忆设置"
      },
      {
        "key": "identityLinks",
        "group": "主人与记忆",
        "label": "跨渠道身份绑定",
        "type": "list",
        "help": "可选，每行填写 用户ID=共同身份标识；只接受允许列表中的用户，双方填写相同标识才共享私聊。",
        "advanced": false,
        "fold": "更多身份与记忆设置"
      },
      {
        "key": "attachments",
        "group": "附件与传输",
        "label": "接收附件",
        "type": "boolean",
        "advanced": false
      },
      {
        "key": "maxAttachmentMB",
        "group": "附件与传输",
        "label": "单附件大小限制（MiB）",
        "type": "number",
        "min": 1,
        "max": 20,
        "advanced": false
      }
    ],
    "credentialTitle": "机器人凭证",
    "credentialsFirst": true
  },
  "dsh-channel-feishu": {
    "rowId": "channel-feishu",
    "endpoint": "feishuChannelSettings",
    "title": "飞书渠道",
    "description": "将飞书消息接入 DSH 原生会话，支持回复、附件和渠道设置。",
